# Telegram (Token obtenido en Telegram con @BotFather)
TELEGRAM_BOT_TOKEN=
# Opcional pero recomendado: cualquier cadena secreta que tú inventes, para que
# nadie más pueda mandarle peticiones falsas a tu webhook.
TELEGRAM_WEBHOOK_SECRET=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Google Sheets
GOOGLE_SHEET_ID=
# En Railway: pega aquí el CONTENIDO COMPLETO de tu credentials.json (todo el JSON, en una sola variable).
# En local (desarrollo en tu máquina): deja esto vacío y usa GOOGLE_CREDENTIALS_PATH en su lugar.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_WORKSHEET_NAME=Actividades

# Carpeta de Google Drive donde se suben las fotos de evidencia
# (ya no se usa — las evidencias se guardan en Supabase Storage)
DRIVE_FOLDER_ID=

# Supabase Storage (supabase.com > Project Settings > API)
# SUPABASE_URL: Project URL (ej. https://xyzcompany.supabase.co)
SUPABASE_URL=
# SUPABASE_KEY: usa la "service_role" key (no la "anon" key) para que el bot pueda subir archivos
SUPABASE_KEY=
# Nombre del bucket público que creaste en Supabase Storage (ver README)
SUPABASE_BUCKET=evidencias


# Zona horaria para las horas guardadas en el Sheet
ZONA_HORARIA=America/Mexico_City

