# Telegram (Token obtenido en Telegram con @BotFather)
TELEGRAM_BOT_TOKEN=
# Muy recomendado: cualquier cadena secreta que tú inventes, para que nadie
# más pueda mandarle peticiones falsas a tu webhook (haciéndose pasar por
# cualquier técnico, incluido el admin).
TELEGRAM_WEBHOOK_SECRET=

# Supabase: base de datos (tablas de supabase/schema.sql) y fotos de evidencia
# (supabase.com > Project Settings > API)
# SUPABASE_URL: Project URL (ej. https://xyzcompany.supabase.co)
SUPABASE_URL=
# SUPABASE_KEY: usa la "service_role" key (no la "anon" key). Es secreta:
# da acceso total a la base de datos.
SUPABASE_KEY=
# Nombre del bucket público que creaste en Supabase Storage (ver README)
SUPABASE_BUCKET=evidencias

# Zona horaria para fechas y horas de los reportes y del Excel
ZONA_HORARIA=America/Mexico_City

# Cadena secreta que tú inventes, para proteger los endpoints de admin
# (/api/exportar-excel y /api/codigo-activacion). OBLIGATORIA para usarlos:
# si está vacía, esos endpoints rechazan todas las peticiones (403). Se manda
# como header X-Admin-Secret o como ?secret= en la URL.
REPORTE_ADMIN_SECRET=

# Web app de pruebas (chat en el navegador en "/"). No tiene login: quien
# conozca la URL puede escribir como cualquier técnico, incluido el admin.
# Déjala vacía en Railway; pon "true" solo en tu máquina para probar.
WEBAPP_HABILITADA=
