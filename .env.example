# Telegram (más simple que WhatsApp: sin verificación de negocio)
TELEGRAM_BOT_TOKEN=
# Opcional pero recomendado: cualquier cadena secreta que tú inventes, para que
# nadie más pueda mandarle peticiones falsas a tu webhook.
TELEGRAM_WEBHOOK_SECRET=

# WhatsApp Cloud API (Meta for Developers > tu app > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Tú lo inventas: cualquier cadena secreta que pongas también al configurar el webhook en Meta
WHATSAPP_VERIFY_TOKEN=

# OpenAI (platform.openai.com)
OPENAI_API_KEY=

# Google Sheets
GOOGLE_SHEET_ID=
# En Railway: pega aquí el CONTENIDO COMPLETO de tu credentials.json (todo el JSON, en una sola variable).
# En local (desarrollo en tu máquina): deja esto vacío y usa GOOGLE_CREDENTIALS_PATH en su lugar.
GOOGLE_CREDENTIALS_JSON=
GOOGLE_CREDENTIALS_PATH=credentials.json
GOOGLE_WORKSHEET_NAME=Actividades
# Carpeta de Google Drive donde se suben las fotos de evidencia (ver README > Evidencias).
DRIVE_FOLDER_ID=
# Zona horaria para las horas guardadas en el Sheet. Cambia solo si tus técnicos
# no están en horario de Ciudad de México/Durango.
ZONA_HORARIA=America/Mexico_City
